{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orin",
  "version": "0.1.0",
  "identifier": "dev.orin.controlcenter",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "Orin",
        "url": "index.html",
        "width": 620,
        "height": 520,
        "minWidth": 500,
        "minHeight": 450,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/orin-runtime"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
